.page {padding:38rpx 28rpx 64rpx;} .eyebrow {color:#c6ab74;letter-spacing:5rpx;font-size:20rpx;} .title {font-size:52rpx;font-weight:700;margin-top:12rpx;} .subtitle {color:#a8aab7;font-size:26rpx;margin-top:10rpx;line-height:1.6;} .notice {font-size:20rpx;color:#d5ba85;background:#29271f;padding:16rpx;border-radius:12rpx;margin:28rpx 0;} .floors,.actions {display:flex;gap:16rpx;margin:20rpx 0;} .floor {flex:1;background:#242938;color:#b8bbca;margin:0;} .floor.active {background:#e3c790;color:#181b24;} .room {position:relative;height:710rpx;border:3rpx solid #68604f;border-radius:18rpx;background-color:#242833;background-image:linear-gradient(#ffffff06 1px,transparent 1px),linear-gradient(90deg,#ffffff06 1px,transparent 1px);background-size:40rpx 40rpx;overflow:hidden;} .object {position:absolute;box-sizing:border-box;display:flex;align-items:center;justify-content:center;border:2rpx solid #a78b61;border-radius:8rpx;background:#64503d;color:#f5e3c0;font-size:18rpx;font-weight:600;box-shadow:0 10rpx 0 #141822;} .bar {background:#705745;border-color:#d5b474;} .fixture {background:#252331;color:#c5bdde;border-color:#645c7b;} .pool {background:#27564d;border:7rpx solid #755d45;} .stairs {background:#353946;border-color:#777b8d;font-size:17rpx;} .chair {position:absolute;width:12rpx;height:30rpx;background:#ad8d61;border-radius:4rpx;} .chair.left {left:-18rpx;} .chair.right {right:-18rpx;} .person {position:absolute;transform:translate(-50%,-50%);text-align:center;font-size:19rpx;z-index:2;} .face {width:52rpx;height:52rpx;background:#d4afd9;color:#292333;display:flex;align-items:center;justify-content:center;border:4rpx solid #f3dbf6;border-radius:18rpx;font-weight:bold;margin-bottom:4rpx;} .self {pointer-events:none;} .self .face {background:#dcbd80;border-color:#ffedbd;font-size:15rpx;} .hint {font-size:22rpx;color:#acafbf;margin:18rpx 0;line-height:1.5;} .card {background:#1d2230;padding:26rpx;border-radius:20rpx;margin-top:24rpx;} .card-title {font-size:32rpx;font-weight:600;} .actions button {flex:1;background:#353244;color:#f0dce8;margin:0;font-size:24rpx;} input {background:#121722;padding:20rpx;border-radius:10rpx;font-size:26rpx;} .placeholder {color:#969bab;} .send {background:#ddc18c;color:#181b24;margin-top:16rpx;} .message {padding:14rpx 0;font-size:26rpx;overflow-wrap:break-word;}
